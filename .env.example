# WhatsApp
WS_SESSION_DIR=.wwebjs_auth
WS_CHAT_LIMIT=
WS_MESSAGE_LIMIT=

# Telegram
TG_SESSION_DIR=.tg_auth
TG_API_ID=
TG_API_HASH=

# Email
# Two equivalent ways to configure email accounts:
#
# (1) Point at a JSON file (preferred, can be pretty-printed):
EMAIL_SESSION_DIR=.email_auth
EMAIL_ACCOUNTS_FILE=accounts.json
#
# accounts.json example:
# [
#   {
#     "id": "personal-gmail",
#     "provider": "gmail",
#     "address": "you@gmail.com",
#     "gmail": {
#       "user": "you@gmail.com",
#       "app_password": "abcd efgh ijkl mnop"
#     }
#   },
#   {
#     "id": "work-imap",
#     "provider": "imap",
#     "address": "you@work.example.com",
#     "imap": {
#       "host": "mail.work.example.com",
#       "port": 993,
#       "user": "you@work.example.com",
#       "password": "secret",
#       "tls": true,
#       "mailbox": "INBOX",
#       "smtp": {
#         "host": "smtp.work.example.com",
#         "port": 465,
#         "user": "you@work.example.com",
#         "password": "secret",
#         "secure": true
#       }
#     }
#   }
# ]
#
# (2) Indexed env blocks (no JSON file, fully inline in .env):
# EMAIL_ACCOUNTS_1_ID=personal-gmail
# EMAIL_ACCOUNTS_1_PROVIDER=gmail
# EMAIL_ACCOUNTS_1_ADDRESS=you@gmail.com
# EMAIL_ACCOUNTS_1_GMAIL_USER=you@gmail.com
# EMAIL_ACCOUNTS_1_GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
#
# EMAIL_ACCOUNTS_2_ID=work-imap
# EMAIL_ACCOUNTS_2_PROVIDER=imap
# EMAIL_ACCOUNTS_2_ADDRESS=you@work.example.com
# EMAIL_ACCOUNTS_2_IMAP_HOST=mail.work.example.com
# EMAIL_ACCOUNTS_2_IMAP_PORT=993
# EMAIL_ACCOUNTS_2_IMAP_USER=you@work.example.com
# EMAIL_ACCOUNTS_2_IMAP_PASSWORD=secret
# EMAIL_ACCOUNTS_2_IMAP_TLS=true
# EMAIL_ACCOUNTS_2_IMAP_SMTP_HOST=smtp.work.example.com
# EMAIL_ACCOUNTS_2_IMAP_SMTP_PORT=465
# EMAIL_ACCOUNTS_2_IMAP_SMTP_USER=you@work.example.com
# EMAIL_ACCOUNTS_2_IMAP_SMTP_PASSWORD=secret
# EMAIL_ACCOUNTS_2_IMAP_SMTP_SECURE=true
#
# Note: EMAIL_ACCOUNTS_FILE is checked first; if it is set the indexed
# blocks are ignored. If neither is set, the email source is skipped.

# Server
PORT=3000
# Leave unset to auto-generate on first run; set to a fixed UUID to persist across restarts.
API_KEY=